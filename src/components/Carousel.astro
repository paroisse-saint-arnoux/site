---
// Carrousel de photos qui défile tout seul (toutes les 5 secondes).
// Le défilement s'arrête au survol, au focus clavier, au toucher, ou avec le
// bouton pause, et n'est pas automatique si le visiteur a demandé de réduire
// les animations. Sans JavaScript, on fait défiler les photos à la main.
import Icon from './Icon.astro';

interface Props {
  photos: { photo: string; description: string }[];
  label?: string;
}

const { photos, label = 'Photos' } = Astro.props;
---

<div class="carousel" role="region" aria-roledescription="carrousel" aria-label={label} data-carousel>
  <div class="track" tabindex="0">
    {
      photos.map((p, i) => (
        <figure class="slide" role="group" aria-roledescription="photo" aria-label={`${i + 1} sur ${photos.length}`}>
          <img src={p.photo} alt={p.description} loading="lazy" decoding="async" width="1600" height="1067" />
        </figure>
      ))
    }
  </div>
  <div class="controls" hidden>
    <button type="button" class="prev" aria-label="Photo précédente"><Icon name="ChevronLeft" /></button>
    <button type="button" class="toggle" aria-label="Mettre en pause le défilement">
      <span class="pause"><Icon name="Pause" size={18} /></span>
      <span class="play"><Icon name="Play" size={18} /></span>
    </button>
    <div class="dots">
      {photos.map((_, i) => <button type="button" aria-label={`Photo ${i + 1}`} data-index={i} />)}
    </div>
    <button type="button" class="next" aria-label="Photo suivante"><Icon name="ChevronRight" /></button>
  </div>
</div>

<style>
  .carousel {
    margin: 2rem 0 0;
  }

  .track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    border-radius: var(--radius);
    background: var(--blue-dark);
  }

  .track::-webkit-scrollbar {
    display: none;
  }

  .track:focus-visible {
    outline: 3px solid var(--ochre);
    outline-offset: 3px;
  }

  .slide {
    position: relative;
    flex: 0 0 100%;
    margin: 0;
    scroll-snap-align: start;
    aspect-ratio: 3 / 2;
  }

  .slide img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 12px;
  }

  .controls[hidden] {
    display: none;
  }

  .controls > button {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--card);
    color: var(--blue);
    cursor: pointer;
  }

  .controls > button:hover {
    border-color: var(--blue);
  }

  .toggle .play,
  .carousel.paused .toggle .pause {
    display: none;
  }

  .carousel.paused .toggle .play {
    display: contents;
  }

  .dots {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2px;
  }

  .dots button {
    width: 22px;
    height: 22px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .dots button::before {
    content: '';
    display: block;
    width: 10px;
    height: 10px;
    margin: auto;
    border-radius: 50%;
    background: var(--line);
  }

  .dots button[aria-current='true']::before {
    background: var(--blue);
  }

  @media (max-width: 560px) {
    .dots {
      display: none;
    }
  }
</style>

<script>
  const DELAY = 5000;

  for (const root of document.querySelectorAll<HTMLElement>('[data-carousel]')) {
    const track = root.querySelector<HTMLElement>('.track')!;
    const slides = track.children;
    const dots = [...root.querySelectorAll<HTMLButtonElement>('.dots button')];
    const toggle = root.querySelector<HTMLButtonElement>('.toggle')!;
    root.querySelector<HTMLElement>('.controls')!.hidden = false;

    let index = 0;
    let timer: number | undefined;
    // Pause demandée par le visiteur (bouton) ou par ses réglages.
    let stopped = matchMedia('(prefers-reduced-motion: reduce)').matches;
    // Pause temporaire : survol, focus, toucher, onglet caché.
    let held = false;

    const go = (i: number, smooth = true) => {
      index = (i + slides.length) % slides.length;
      track.scrollTo({ left: index * track.clientWidth, behavior: smooth ? 'smooth' : 'instant' });
    };

    const render = () => {
      dots.forEach((d, i) => d.setAttribute('aria-current', String(i === index)));
      root.classList.toggle('paused', stopped);
      toggle.setAttribute('aria-label', stopped ? 'Relancer le défilement' : 'Mettre en pause le défilement');
    };

    const schedule = () => {
      clearTimeout(timer);
      if (!stopped && !held) timer = window.setTimeout(() => go(index + 1), DELAY);
    };

    track.addEventListener('scroll', () => {
      const i = Math.round(track.scrollLeft / track.clientWidth);
      if (i !== index) index = i;
      render();
      schedule();
    }, { passive: true });

    root.querySelector('.prev')!.addEventListener('click', () => go(index - 1));
    root.querySelector('.next')!.addEventListener('click', () => go(index + 1));
    dots.forEach((d, i) => d.addEventListener('click', () => go(i)));
    toggle.addEventListener('click', () => {
      stopped = !stopped;
      render();
      schedule();
    });

    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft' || e.key === 'ArrowRight') {
        e.preventDefault();
        go(index + (e.key === 'ArrowRight' ? 1 : -1));
      }
    });

    const hold = (value: boolean) => () => {
      held = value;
      schedule();
    };
    track.addEventListener('mouseenter', hold(true));
    track.addEventListener('mouseleave', hold(false));
    track.addEventListener('focusin', hold(true));
    track.addEventListener('focusout', hold(false));
    track.addEventListener('touchstart', hold(true), { passive: true });
    track.addEventListener('touchend', hold(false), { passive: true });
    document.addEventListener('visibilitychange', () => {
      held = document.hidden;
      schedule();
    });
    addEventListener('resize', () => go(index, false));

    render();
    schedule();
  }
</script>
