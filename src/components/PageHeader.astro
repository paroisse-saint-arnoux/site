---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  position?: string;
}

const { eyebrow, title, lead, image, imageAlt = '', position = 'center' } = Astro.props;
---

<section class:list={['page-header', { 'has-image': image }]}>
  {
    image && (
      <Image
        class="bg"
        src={image}
        alt={imageAlt}
        width={2200}
        widths={[640, 1024, 1600, 2200]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        style={`object-position: ${position}`}
      />
    )
  }
  <div class="wrap inner">
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</section>

<style>
  .page-header {
    position: relative;
    padding-block: clamp(40px, 7vw, 72px) clamp(32px, 5vw, 56px);
    background: var(--paper-2);
    border-bottom: 1px solid var(--line);
  }

  .page-header .lead {
    max-width: 60ch;
    margin-bottom: 0;
  }

  .has-image {
    min-height: clamp(260px, 38vw, 420px);
    display: flex;
    align-items: flex-end;
    color: #fff;
    border-bottom: 0;
    overflow: hidden;
  }

  .has-image::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(14 26 41 / 85%), rgb(14 26 41 / 35%) 55%, rgb(14 26 41 / 10%));
  }

  .bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .inner {
    position: relative;
    z-index: 1;
    width: 100%;
  }

  .has-image h1 {
    color: #fff;
  }

  .has-image .eyebrow {
    color: #f3d79b;
  }

  .has-image .lead {
    color: #eef2f6;
  }
</style>
