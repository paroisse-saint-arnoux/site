---
import type { AgendaItem } from '../data/agenda';
import { dayNumber, formatDate, itemDetails, monthShort, todayIso } from '../lib/dates';
import { calendarEvent, itemIcsUrl, upcomingItems } from '../lib/ics';
import { site } from '../data/site';
import Icon from './Icon.astro';
import Markdown from './Markdown.astro';

interface Props {
  items: AgendaItem[];
  /** Masque automatiquement (côté navigateur) les dates passées */
  hidePast?: boolean;
  /** Nombre maximum de dates affichées (après masquage des dates passées) */
  limit?: number;
  withYear?: boolean;
  /** Fichier .ics regroupant toutes les dates de la liste (bouton « Ajouter ces dates » sous la liste) */
  ics?: string;
  /** Nom de la liste, repris dans l'agenda de l'utilisateur */
  name?: string;
}

const { items, hidePast = false, limit, withYear = false, ics, name } = Astro.props;
const upcoming = upcomingItems(items);
const today = todayIso();
const all = ics && {
  name: name ? `${site.name} – ${name}` : site.name,
  dates: upcoming.map(calendarEvent),
  icsFile: ics,
};
---

<ol class="agenda-list" data-hide-past={hidePast ? '' : undefined} data-limit={limit}>
  {
    items.map((item, i) => (
      <li data-date={item.end ?? item.date} hidden={limit !== undefined && i >= limit}>
        <span class="tile" aria-hidden="true">
          <span class="d">{dayNumber(item.date)}</span>
          <span class="m">{monthShort(item.date)}</span>
        </span>
        <div class="body">
          <span class="when">{formatDate(item, withYear)}</span>
          <span class="what">{item.title}</span>
          {itemDetails(item) && <span class="where">{itemDetails(item)}</span>}
          {item.programme && (item.end ?? item.date) >= today && (
            <div class="programme">
              <Markdown text={item.programme} breaks />
            </div>
          )}
        </div>
        <a class="add" href={itemIcsUrl(item)} data-atcb={JSON.stringify(calendarEvent(item))} title="Ajouter à mon agenda" aria-label={`Ajouter « ${item.title} » à mon agenda`}>
          <Icon name="CalendarPlus" />
        </a>
      </li>
    ))
  }
</ol>
{
  all && upcoming.length > 0 && (
    <p class="add-all">
      <a class="btn btn--ghost" href={ics} data-atcb={JSON.stringify(all)}>
        <Icon name="CalendarPlus" /> Ajouter ces dates à mon agenda
      </a>
    </p>
  )
}

<script>
  import '../lib/add-to-calendar';

  // Grise les dates passées (ou les masque si data-hide-past) à la date du jour.
  const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Paris' }).format(new Date());
  document.querySelectorAll<HTMLOListElement>('.agenda-list').forEach((list) => {
    const hide = list.hasAttribute('data-hide-past');
    const limit = list.dataset.limit ? Number(list.dataset.limit) : Infinity;
    let shown = 0;
    list.querySelectorAll<HTMLLIElement>('li[data-date]').forEach((li) => {
      const past = (li.dataset.date ?? '') < today;
      if (past && !hide) li.classList.add('past');
      li.hidden = (past && hide) || shown >= limit;
      if (!li.hidden) shown++;
    });
    // Plus aucune date à venir : inutile de proposer de les ajouter
    const addAll = list.nextElementSibling;
    if (addAll?.classList.contains('add-all') && !list.querySelector('li:not(.past):not([hidden])')) {
      (addAll as HTMLElement).hidden = true;
    }
  });
</script>

<style>
  .agenda-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }

  li {
    display: flex;
    gap: 14px;
    align-items: center;
  }

  li[hidden] {
    display: none;
  }

  li.past {
    opacity: 0.45;
  }

  /* Programme : la vignette et le bouton restent en haut */
  li:has(.programme) {
    align-items: flex-start;
  }

  li.past .programme {
    display: none;
  }

  .tile {
    flex: none;
    width: 52px;
    height: 56px;
    border-radius: 8px;
    background: var(--paper-2);
    border: 1px solid var(--line);
    display: grid;
    place-content: center;
    text-align: center;
    line-height: 1;
  }

  .d {
    font-family: var(--serif);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--blue-dark);
  }

  .m {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--terracotta);
    font-weight: 600;
  }

  .body {
    display: grid;
    line-height: 1.35;
  }

  .when {
    font-size: 0.85rem;
    color: var(--ink-soft);
  }

  .what {
    font-weight: 600;
  }

  .where {
    font-size: 0.92rem;
    color: var(--ink-soft);
  }

  .programme {
    margin-top: 6px;
    font-size: 0.92rem;
    line-height: 1.45;
  }

  .programme :global(p),
  .programme :global(ul) {
    margin: 0 0 6px;
  }

  .programme :global(ul) {
    padding-left: 1.2em;
  }

  .programme :global(:last-child) {
    margin-bottom: 0;
  }

  .add-all {
    margin: 18px 0 0;
    text-align: center;
  }

  .add-all[hidden] {
    display: none;
  }

  .add-all .btn {
    padding: 0.45em 1em;
    font-size: 0.92rem;
  }

  /* Bouton discret, plus visible au survol de la date (toujours présent pour
     les écrans tactiles) */
  .add {
    flex: none;
    margin-left: auto;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    color: var(--blue);
    opacity: 0.55;
    transition: opacity 0.15s, background 0.15s;
  }

  li:hover .add,
  .add:focus-visible {
    opacity: 1;
  }

  .add:hover {
    background: var(--paper-2);
  }

  li.past .add {
    display: none;
  }
</style>
