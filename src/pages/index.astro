---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Channels from '../components/Channels.astro';
import AgendaList from '../components/AgendaList.astro';
import Markdown from '../components/Markdown.astro';
import { agenda } from '../data/agenda';
import { contact, livret, permanences, site } from '../data/site';
import { todayIso } from '../lib/dates';
import { getPage } from '../lib/content';
import hero from '../assets/photos/pretres-enfants-de-choeur.jpg';
import kt from '../assets/photos/kt.jpg';
import saintJoseph from '../assets/saint-joseph/l-ensemble-paroissial-dans-son-site.jpeg';

const today = todayIso();
// Les dates passées au moment du build sont écartées ; le navigateur
// refait le tri à la date du jour.
const upcoming = agenda
  .filter((s) => s.home)
  .flatMap((s) => s.items)
  .filter((item, i, all) => all.findIndex((o) => o.date === item.date && o.title === item.title) === i)
  .filter((item) => (item.end ?? item.date) >= today)
  .sort((a, b) => a.date.localeCompare(b.date));

const { data: page, Content } = await getPage('accueil');
---

<Base>
  <section class="hero">
    <Image
      class="hero-img"
      src={hero}
      alt={page.photo}
      width={2000}
      widths={[640, 1024, 1600, 2000]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="wrap hero-inner">
      <span class="eyebrow">{page.surtitre}</span>
      <h1>{page.titre}</h1>
      <p class="lead">{site.villages.join(' · ')}</p>
      <div class="actions">
        <a class="btn btn--light" href="/horaires/"><Icon name="Clock" /> {page.bouton_horaires}</a>
        <a class="btn btn--ghost on-dark" href="/contact/"><Icon name="Phone" /> {page.bouton_contact}</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="grid shortcuts">
        {
          page.raccourcis.map((s: any) => (
            <a class="card shortcut" href={s.lien}>
              <span class="ico"><Icon name={s.icone} size={24} /></span>
              <h2>{s.titre}</h2>
              <p>{s.texte}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="wrap grid grid--2 split">
      <div>
        <span class="eyebrow">{page.agenda.surtitre}</span>
        <h2>{page.agenda.titre}</h2>
        <AgendaList items={upcoming} hidePast limit={6} withYear />
        <div class="actions">
          <a class="btn" href="/agenda/"><Icon name="CalendarDays" /> {page.agenda.bouton_annee}</a>
          <a class="btn btn--ghost" href={livret.url}><Icon name="Download" /> {page.agenda.bouton_livret}</a>
        </div>
      </div>
      <div class="card welcome">
        <span class="eyebrow">{page.permanences.surtitre}</span>
        <h2>{page.permanences.titre}</h2>
        <Markdown text={page.permanences.texte} />
        <table class="perm">
          <tbody>
            {
              permanences.map((p) => (
                <tr>
                  <th scope="row">{p.day}</th>
                  <td>{p.slots.join(' et ')}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
        <p class="small muted">{page.permanences.note}</p>
        <p>
          <a href={contact.phoneHref}><Icon name="Phone" size={16} /> {contact.phone}</a><br />
          <a href={`mailto:${contact.email}`}><Icon name="Mail" size={16} /> {contact.email}</a>
        </p>
      </div>
    </div>
  </section>

  <section class="section sj2">
    <div class="wrap grid grid--2 split">
      <a class="sj2-image" href={page.saint_joseph.lien} target="_blank" rel="noopener">
        <Image src={saintJoseph} alt={page.saint_joseph.photo} width={1200} widths={[480, 800, 1200]} sizes="(max-width: 700px) 100vw, 50vw" />
      </a>
      <div>
        <span class="eyebrow">{page.saint_joseph.surtitre}</span>
        <h2>{page.saint_joseph.titre}</h2>
        <Markdown text={page.saint_joseph.texte} />
        <dl class="sj2-chiffres">
          {
            page.saint_joseph.chiffres.map((c: any) => (
              <div>
                <dt>{c.valeur}</dt>
                <dd>{c.libelle}</dd>
              </div>
            ))
          }
        </dl>
        <div class="actions">
          <a class="btn btn--light" href={page.saint_joseph.lien} target="_blank" rel="noopener">
            {page.saint_joseph.bouton_projet} <Icon name="ExternalLink" />
          </a>
          <a class="btn btn--ghost on-dark" href={page.saint_joseph.lien_don} target="_blank" rel="noopener">
            <Icon name="Heart" /> {page.saint_joseph.bouton_don}
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <span class="eyebrow">{page.canaux.surtitre}</span>
      <h2>{page.canaux.titre}</h2>
      <p class="lead">{page.canaux.intro}</p>
      <Channels />
    </div>
  </section>

  <section class="section section--alt">
    <div class="wrap grid grid--2 split">
      <Image class="rounded" src={kt} alt={page.jeunes.photo} width={1200} widths={[480, 800, 1200]} sizes="(max-width: 700px) 100vw, 50vw" />
      <div>
        <span class="eyebrow">{page.jeunes.surtitre}</span>
        <h2>{page.jeunes.titre}</h2>
        <Content />
        <div class="actions">
          <a class="btn" href="/activites/">{page.jeunes.bouton}</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    min-height: min(78vh, 640px);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    color: #fff;
  }

  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(14 26 41 / 88%), rgb(14 26 41 / 35%) 60%, rgb(14 26 41 / 5%));
  }

  .hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    width: 100%;
    padding-block: 48px;
  }

  .hero h1 {
    color: #fff;
    font-size: clamp(2.6rem, 7vw, 4.2rem);
  }

  .hero .eyebrow {
    color: #f3d79b;
  }

  .hero .lead {
    color: #eef2f6;
    max-width: 52ch;
  }

  .on-dark {
    color: #fff;
    border-color: #fff;
  }

  .on-dark:hover {
    background: #fff;
    color: var(--blue-dark);
  }

  .shortcuts {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr));
    margin-top: -88px;
    position: relative;
    z-index: 2;
  }

  .shortcut {
    text-decoration: none;
    color: var(--ink);
    transition: transform 0.15s, box-shadow 0.15s;
  }

  .shortcut:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 30px rgb(42 37 33 / 14%);
    color: var(--ink);
  }

  .shortcut h2 {
    font-size: 1.45rem;
    margin-bottom: 0.3em;
  }

  .shortcut p {
    color: var(--ink-soft);
    margin: 0;
    font-size: 0.97rem;
  }

  .ico {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--paper-2);
    color: var(--terracotta);
    margin-bottom: 12px;
  }

  .split {
    align-items: center;
    gap: clamp(24px, 5vw, 56px);
  }

  .welcome a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .perm {
    border-collapse: collapse;
    margin-bottom: 0.5rem;
  }

  .perm th {
    text-align: left;
    padding: 4px 18px 4px 0;
  }

  .perm td {
    padding: 4px 0;
  }

  .rounded {
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .sj2 {
    background: var(--blue-dark);
    color: #dfe6ee;
  }

  .sj2 h2 {
    color: #fff;
  }

  .sj2 .eyebrow {
    color: #f3d79b;
  }

  .sj2 :global(strong) {
    color: #fff;
  }

  .sj2-image img {
    border-radius: var(--radius);
    box-shadow: 0 12px 40px rgb(0 0 0 / 35%);
    transition: transform 0.2s;
  }

  .sj2-image:hover img {
    transform: scale(1.01);
  }

  .sj2-chiffres {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 32px;
    margin: 1.5rem 0 0;
  }

  .sj2-chiffres dt {
    font-family: var(--serif);
    font-size: 2.2rem;
    font-weight: 600;
    line-height: 1;
    color: #f3d79b;
  }

  .sj2-chiffres dd {
    margin: 4px 0 0;
    font-size: 0.9rem;
  }

  @media (max-width: 700px) {
    .shortcuts {
      margin-top: 0;
    }
  }
</style>
