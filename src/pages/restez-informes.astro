---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Channels from '../components/Channels.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import Icon from '../components/Icon.astro';
import { channels } from '../data/site';
import { getPage } from '../lib/content';

const { data: page } = await getPage('restez-informes');
---

<Base title={page.surtitre} description={page.description}>
  <PageHeader eyebrow={page.surtitre} title={page.titre} lead={page.intro} />

  <section class="section">
    <div class="wrap">
      <Channels />
    </div>
  </section>

  <section class="section section--alt">
    <div class="wrap grid grid--2 two">
      <div class="card" id="newsletter">
        <h2>{page.newsletter.titre}</h2>
        <p class="muted">{page.newsletter.texte}</p>
        <NewsletterForm />
      </div>
      <div class="card">
        <h2>{page.whatsapp.titre}</h2>
        <p class="muted">{page.whatsapp.texte}</p>
        <div class="actions">
          <a class="btn wa" href={channels.whatsapp} target="_blank" rel="noopener"><Icon name="whatsapp" /> {page.whatsapp.bouton}</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .two {
    align-items: start;
  }

  #newsletter {
    scroll-margin-top: 90px;
  }

  .wa {
    background: #25d366;
    border-color: #25d366;
  }

  .wa:hover {
    background: #0d6b39;
    border-color: #0d6b39;
  }
</style>
