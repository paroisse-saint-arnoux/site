---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { getPage } from '../lib/content';

const { data: page } = await getPage('erreur-404');
---

<Base title={page.titre}>
  <PageHeader eyebrow={page.surtitre} title={page.titre} lead={page.intro}>
    <div class="actions">
      <a class="btn" href="/">Accueil</a>
      <a class="btn btn--ghost" href="/horaires/">Horaires des messes</a>
      <a class="btn btn--ghost" href="/contact/">Contact</a>
    </div>
  </PageHeader>
</Base>
