---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Carousel from '../../components/Carousel.astro';
import { getOrdered, render } from '../../lib/content';

export async function getStaticPaths() {
  const articles = await getOrdered('histoire');
  return articles.map((article) => ({ params: { slug: article.id }, props: { article, articles } }));
}

const { article, articles } = Astro.props;
const { Content } = await render(article);
const others = articles.filter((a) => a.id !== article.id);
const photos = article.data.galerie ?? [];
const description = article.data.resume.slice(0, 160).replace(/\s+\S*$/, '…');
---

<Base title={article.data.titre} description={description}>
  <PageHeader eyebrow="Paroisse" title={article.data.titre} />
  <section class="section">
    <div class="wrap">
      <article class="prose histoire" data-article={article.id}>
        <Content />
        {photos.length > 0 && <Carousel photos={photos} label={`Photos : ${article.data.titre}`} />}
      </article>
      <hr />
      <nav aria-label="Autres pages de la paroisse">
        <h2>À lire aussi</h2>
        <ul class="others">
          {others.map((a) => <li><a href={`/histoire/${a.id}/`}>{a.data.titre}</a></li>)}
          <li><a href="/histoire/">Toute la paroisse</a></li>
        </ul>
      </nav>
    </div>
  </section>
</Base>

<style>
  .histoire :global(h2) {
    margin-top: 2rem;
  }

  /* Photos plus grandes sur la page des jumelages */
  .histoire[data-article='jumelages'] {
    --figure-float: 320px;
  }

  @media (max-width: 560px) {
    .histoire[data-article='jumelages'] :global(figure[data-align]) {
      max-width: 100%;
    }
  }

  hr {
    clear: both;
    border: 0;
    border-top: 1px solid var(--line);
    margin: 48px 0 32px;
  }

  .others {
    padding-left: 1.2em;
  }
</style>
