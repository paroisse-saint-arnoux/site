Options -Indexes
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS et domaine sans www
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://saint-arnoux.fr%{REQUEST_URI} [L,R=301]

  # Anciennes adresses du site WordPress
  RewriteRule ^horaires-de-messes/?$ /horaires/ [L,R=301]
  RewriteRule ^inscription-aux-activites/?$ /activites/ [L,R=301]
  RewriteRule ^demander-un-sacrement/?$ /sacrements/ [L,R=301]
  RewriteRule ^inscription-aux-mails/?$ /restez-informes/ [L,R=301]
  RewriteRule ^feuilles-paroissiales/?$ /restez-informes/ [L,R=301]
  RewriteRule ^2022/11/leglise-notre-dame-de-canlache/?$ /histoire/notre-dame-de-canlache/ [L,R=301]
  RewriteRule ^2022/11/leglise-notre-dame-du-brusc/?$ /histoire/notre-dame-du-brusc/ [L,R=301]
  RewriteRule ^2022/11/anton-prinner/?$ /histoire/anton-prinner/ [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
